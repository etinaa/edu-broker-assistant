# Copy to .env and fill in. .env is git-ignored; load it before starting: set -a; . ./.env; set +a

# Model provider: ollama | claude
LLM_PROVIDER=ollama

# Ollama model; it must support tools (ollama show <model>). Pull it first: ollama pull qwen2.5:14b
OLLAMA_MODEL=qwen2.5:14b

# Claude model and API key; the key is required only when LLM_PROVIDER=claude
CLAUDE_MODEL=claude-haiku-4-5
ANTHROPIC_API_KEY=
